{
  "manifest_version": 3,
  "name": "YouTube Sentiment Insights",
  "version": "1.0",
  "description": "Summarises the sentiment of a YouTube video's comments.",
  "action": { "default_popup": "popup.html", "default_title": "Analyse comments" },
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost:5001/*", "https://www.googleapis.com/*"]
}
